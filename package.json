{
  "name": "pi-web-casual",
  "version": "0.1.0",
  "description": "\u2042 Casual \u2014 a long-running, project-free chat for PI WEB, opened with the Asterism button.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-web",
    "pi-web-plugin",
    "pi-web-ui",
    "pi-coding-agent",
    "casual-chat",
    "ai",
    "chat",
    "lit",
    "typescript",
    "developer-tools",
    "productivity",
    "asterism"
  ],
  "license": "MIT",
  "author": "Edward Champion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paradise-runner/pi-web-casual.git"
  },
  "bugs": {
    "url": "https://github.com/paradise-runner/pi-web-casual/issues"
  },
  "homepage": "https://github.com/paradise-runner/pi-web-casual#readme",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck"
  },
  "devDependencies": {
    "@jmfederico/pi-web": "^1.202610.3",
    "typescript": "^7.0.2"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/paradise-runner/pi-web-casual/main/docs/assets/banner.png"
  },
  "piWeb": {
    "plugins": [
      {
        "id": "pi-web-casual",
        "browserRoot": "dist/browser",
        "module": "dist/browser/index.js",
        "machineSpecific": true,
        "defaultEnabled": true
      }
    ]
  }
}
